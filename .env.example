# Copy to .env and replace the values. Never commit the real .env file.
POSTGRES_DB=daily_tracker
POSTGRES_USER=daily_tracker
POSTGRES_PASSWORD=change-me-local-only

DATABASE_URL=jdbc:postgresql://localhost:5432/daily_tracker
DATABASE_USERNAME=daily_tracker
DATABASE_PASSWORD=change-me-local-only

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=900000
REFRESH_TOKEN_SECRET=replace-with-a-different-random-string-of-at-least-32-characters
REFRESH_TOKEN_EXPIRATION=1209600000

# Future integrations (not used yet)
AI_API_KEY=
FOOD_API_KEY=
