# Copy to .env and replace the values. Never commit the real .env file.
POSTGRES_DB=daily_tracker
POSTGRES_USER=daily_tracker
POSTGRES_PASSWORD=change-me-local-only

DATABASE_URL=jdbc:postgresql://localhost:5432/daily_tracker
DATABASE_USERNAME=daily_tracker
DATABASE_PASSWORD=change-me-local-only

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=900000
REFRESH_TOKEN_SECRET=replace-with-a-different-random-string-of-at-least-32-characters
REFRESH_TOKEN_EXPIRATION=1209600000

# Email confirmation codes. Use a Gmail app password (not your normal password).
# MAIL_MODE=smtp sends real email. MAIL_MODE=log only prints the code in the backend console (development only).
MAIL_MODE=smtp
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=your-address@gmail.com

# Google Gemini API (Google AI Studio) for the AI analysis and coach. Create the key in Google AI Studio. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Future integrations (not used yet)
FOOD_API_KEY=
